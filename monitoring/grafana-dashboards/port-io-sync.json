{
  "dashboard": {
    "title": "Port.io Sync Health",
    "tags": ["port-io", "crossplane", "infrastructure"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Service Uptime",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"port-exporter\"}",
            "legendFormat": "Port Exporter"
          },
          {
            "expr": "up{job=\"webhook-receiver\"}",
            "legendFormat": "Webhook Receiver"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "graphMode": "area",
          "colorMode": "value",
          "orientation": "auto"
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Sync Success Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "rate(port_sync_entities_synced_total{status=\"success\"}[5m]) / rate(port_sync_entities_synced_total[5m])",
            "legendFormat": "Success Rate"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.9, "color": "yellow"},
                {"value": 0.95, "color": "green"}
              ]
            },
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Webhook Processing Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(webhook_receiver_requests_total{status=\"success\"}[5m])",
            "legendFormat": "Success"
          },
          {
            "expr": "rate(webhook_receiver_requests_total{status=~\".*error\"}[5m])",
            "legendFormat": "Errors"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 4,
        "title": "GitHub Actions Runner Status",
        "type": "stat",
        "targets": [
          {
            "expr": "count(up{job=\"github-runner\"} == 1)",
            "legendFormat": "Active Runners"
          },
          {
            "expr": "github_runner_queue_depth",
            "legendFormat": "Queue Depth"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 5,
        "title": "Sync Latency (P50, P95, P99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(port_sync_sync_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(port_sync_sync_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(port_sync_sync_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 6,
        "title": "Resource Sync by Type",
        "type": "table",
        "targets": [
          {
            "expr": "sum by (resource_type) (port_sync_crossplane_resources_total)",
            "legendFormat": "{{resource_type}}",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12}
      },
      {
        "id": 7,
        "title": "API Call Rate by Status",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (status) (rate(port_sync_api_requests_total[5m]))",
            "legendFormat": "{{status}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"}
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12}
      },
      {
        "id": 8,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(port_sync_errors_total[5m])",
            "legendFormat": "{{type}}"
          },
          {
            "expr": "rate(webhook_receiver_requests_total{status=~\".*error\"}[5m])",
            "legendFormat": "webhook_error"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Errors/sec"}
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12}
      }
    ]
  }
}
