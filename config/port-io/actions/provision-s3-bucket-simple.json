{
  "identifier": "provision_s3_bucket",
  "title": "Provision S3 Bucket",
  "icon": "Bucket",
  "description": "Request a new S3 bucket for application use",
  "trigger": {
    "type": "self-service",
    "operation": "CREATE",
    "userInputs": {
      "properties": {
        "purpose": {
          "title": "Bucket Purpose",
          "type": "string",
          "description": "Business purpose (e.g., 'user-uploads', 'backup-storage', 'logs')",
          "pattern": "^[a-z0-9-]+$"
        },
        "environment": {
          "title": "Environment",
          "type": "string",
          "enum": ["dev", "staging", "production"],
          "default": "dev"
        },
        "team": {
          "title": "Team Name",
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "bucketName": {
          "title": "Bucket Name",
          "type": "string",
          "description": "AWS S3 bucket name (must be globally unique)",
          "pattern": "^portal-kombat-[a-z0-9-]+$"
        },
        "versioning": {
          "title": "Enable Versioning",
          "type": "boolean",
          "default": false
        },
        "encryption": {
          "title": "Encryption Type",
          "type": "string",
          "enum": ["AES256", "aws:kms"],
          "default": "AES256"
        }
      },
      "required": ["purpose", "environment", "team", "bucketName"]
    }
  },
  "invocationMethod": {
    "type": "GITHUB",
    "githubWorkflow": {
      "org": "ims-platform-dev",
      "repo": "portal-kombat",
      "workflow": "port-s3-provisioning.yaml",
      "reportWorkflowStatus": true
    }
  },
  "publish": true
}
